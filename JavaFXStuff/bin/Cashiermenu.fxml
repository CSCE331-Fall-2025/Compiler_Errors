<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.SeparatorMenuItem?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="739.0" prefWidth="996.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="CashierMenuController">
  <children>
    <MenuBar prefHeight="30.0" prefWidth="905.0" VBox.vgrow="NEVER">
      <menus>
        <Menu mnemonicParsing="false" text="File">
          <items>
            <MenuItem fx:id="swapPage" mnemonicParsing="false" text="Swap to Manager" />
          </items>
        </Menu>
        <Menu mnemonicParsing="false" text="Edit">
          <items>
            <MenuItem mnemonicParsing="false" text="Undo" />
            <MenuItem mnemonicParsing="false" text="Redo" />
            <SeparatorMenuItem mnemonicParsing="false" />
            <MenuItem mnemonicParsing="false" text="Cut" />
            <MenuItem mnemonicParsing="false" text="Copy" />
            <MenuItem mnemonicParsing="false" text="Paste" />
            <MenuItem mnemonicParsing="false" text="Delete" />
            <SeparatorMenuItem mnemonicParsing="false" />
            <MenuItem mnemonicParsing="false" text="Select All" />
            <MenuItem mnemonicParsing="false" text="Unselect All" />
          </items>
        </Menu>
        <Menu mnemonicParsing="false" text="Help">
          <items>
            <MenuItem mnemonicParsing="false" text="About MyHelloApp" />
          </items>
        </Menu>
      </menus>
    </MenuBar>
    <AnchorPane maxHeight="-1.0" maxWidth="-1.0" prefHeight="650.0" prefWidth="996.0" VBox.vgrow="ALWAYS">
      <children>
        <BorderPane layoutX="10.0" layoutY="10.0" prefHeight="500.0" prefWidth="300.0">
          <top>
            <Label style="-fx-font-size: 14; -fx-font-weight: bold;" text="Menu" BorderPane.alignment="CENTER" />
          </top>
          <center>
            <VBox fx:id="menuContainer" prefHeight="450.0" prefWidth="280.0" style="-fx-border-color: #cccccc; -fx-border-width: 1;" BorderPane.alignment="CENTER" />
          </center>
        </BorderPane>
        
        <BorderPane layoutX="320.0" layoutY="10.0" prefHeight="500.0" prefWidth="300.0">
          <center>
            <ListView fx:id="notesListView" prefHeight="468.0" prefWidth="280.0" BorderPane.alignment="CENTER" />
          </center>
          <top>
            <Label style="-fx-font-size: 14; -fx-font-weight: bold;" text="Additional Notes" BorderPane.alignment="CENTER" />
          </top>
        </BorderPane>
        
        <BorderPane layoutX="630.0" layoutY="10.0" prefHeight="500.0" prefWidth="350.0">
          <center>
            <ListView fx:id="receiptListView" prefHeight="468.0" prefWidth="330.0" BorderPane.alignment="CENTER" />
          </center>
          <top>
            <Label style="-fx-font-size: 14; -fx-font-weight: bold;" text="Purchases / Receipt" BorderPane.alignment="CENTER" />
          </top>
        </BorderPane>
        
        <BorderPane layoutX="10.0" layoutY="520.0" prefHeight="110.0" prefWidth="280.0">
          <top>
            <Label style="-fx-font-size: 12; -fx-font-weight: bold;" text="Select Person" BorderPane.alignment="CENTER" />
          </top>
          <center>
            <ComboBox fx:id="personSelector" prefWidth="260.0" BorderPane.alignment="CENTER" />
          </center>
          <bottom>
            <HBox prefHeight="30.0" spacing="5.0" BorderPane.alignment="CENTER">
              <children>
                <Button mnemonicParsing="false" onAction="#addNewPerson" prefWidth="130.0" text="Add Person" />
                <Button mnemonicParsing="false" onAction="#addNewSeasonalItem" prefWidth="130.0" style="-fx-font-size: 10;" text="+ Seasonal Item" />
              </children>
            </HBox>
          </bottom>
        </BorderPane>
        
        <Button layoutX="630.0" layoutY="520.0" mnemonicParsing="false" onAction="#handleCheckout" prefHeight="50.0" prefWidth="350.0" style="-fx-font-size: 14; -fx-padding: 10;" text="Checkout" />
      </children>
    </AnchorPane>
  </children>
</VBox>
